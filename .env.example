# Required. Use the permanent *.myshopify.com domain, never the public custom domain.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Optional for public, tokenless Storefront API fields; required for protected fields.
# Keep this server-side. Do not prefix it with NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token

# Reserved for authenticated Shopify webhook/on-demand revalidation work.
SHOPIFY_REVALIDATION_SECRET=replace-with-a-long-random-value

# Retail Cart API activation gate. Keep false until the Shopify/wholesale
# commerce boundary has been approved and the cart test matrix is ready.
SHOPIFY_CART_ENABLED=false

# Required when the retail cart is enabled. Use at least 32 random characters.
# This encrypts the full Shopify cart ID before it is stored in an HTTP-only cookie.
SHOPIFY_CART_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Optional deployment origin used for canonical URLs outside production.
SITE_URL=https://northwestern.golf
